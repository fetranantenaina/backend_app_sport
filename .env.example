# Copie ce fichier en .env et remplis les valeurs.
# Base Neon (adresse de connexion donnée par Neon) :
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/neondb?sslmode=require&channel_binding=require
# Clé de signature des connexions (longue chaîne aléatoire) :
JWT_SECRET=change-moi
# Sans DATABASE_URL, base PostgreSQL locale : DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
